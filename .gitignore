# Environment / secrets — NEVER commit these
.env
.env.local
.env.*.local

# Dependencies
/vendor/
composer.lock

# Logs
storage/logs/*.log
storage/logs/*.txt
!storage/logs/.gitkeep

# OS junk
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/

# Uploaded runtime images (menu photos)
public/uploads/*
!public/uploads/.gitkeep

# Generated PDF invoices
storage/invoices/*
!storage/invoices/.gitkeep

# PHPUnit cache
.phpunit.cache/
.phpunit.result.cache
