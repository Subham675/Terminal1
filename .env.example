# ── App ──────────────────────────────────────
APP_NAME="Terminal 1 The Restaurant"
APP_URL=https://yourdomain.com
APP_ENV=production          # production | development
APP_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# ── MySQL (XAMPP default: host=127.0.0.1, port=3306, user=root, no password) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=terminal1_db
DB_USER=root
DB_PASS=

# ── Google OAuth ─────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# ── SMTP (for OTP emails) ────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=noreply@terminal1.in
MAIL_FROM_NAME="Terminal 1 The Restaurant"

# ── OTP ──────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Razorpay Payments (test mode: https://dashboard.razorpay.com/app/keys) ──
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── Booking Rules ─────────────────────────────
DEPOSIT_AMOUNT=100          # rupees — advance deposit to confirm a table
SLOT_CAPACITY=8              # max bookings allowed per date+time slot
